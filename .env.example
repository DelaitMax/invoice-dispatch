NODE_ENV=development
PORT=3000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=invoice_dispatch

DATABASE_URL=postgres://postgres:postgres@localhost:5432/invoice_dispatch
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379

# pino log level: fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info
# pino-pretty locally. Deliberately separate from NODE_ENV — set explicitly.
LOG_PRETTY=true

# Optional. If set, POST/GET/retry endpoints ALSO require a matching X-API-Key header, on top
# of the browser session below
# API_KEY=

# Swagger UI + /docs/openapi.json. Defaults to true outside production, false in production.
# DOCS_ENABLED=true

# --- Auth (browser session for the frontend console) ---
# Required, >=32 chars. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_COOKIE_NAME=auth_token
JWT_EXPIRES_IN_SECONDS=604800

# Optional one-time bootstrap for the first admin account, read by `pnpm db:seed`. Set both or
# neither.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- Mail (ADR-6: explicit choice, no default, no silent fallback) ---
# mailgun | console. "console" logs the email and writes the PDF to MAIL_OUTBOX_DIR instead
# of calling a real provider — useful for local dev without Mailgun credentials.
MAIL_DRIVER=console

# Required when MAIL_DRIVER=mailgun:
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# EU accounts: https://api.eu.mailgun.net
# MAILGUN_BASE_URL=https://api.mailgun.net

# Used when MAIL_DRIVER=console:
MAIL_OUTBOX_DIR=./tmp/outbox

MAIL_FROM_NAME=Brick and Willow Design
MAIL_FROM_EMAIL=invoices@brickandwillow.example

# --- Sender profile, printed on every invoice PDF and in the email body ---
SENDER_BRAND=Brick and Willow Design
SENDER_NAME=Margaret Brick
SENDER_ADDRESS_LINE1=221B Baker Street
# SENDER_ADDRESS_LINE2=
SENDER_CITY=London
# SENDER_POSTAL_CODE=
# SENDER_COUNTRY=United Kingdom
SENDER_EMAIL=margaret@brickandwillow.example
# SENDER_PHONE=

# --- Invoice ---
INVOICE_CURRENCY_DEFAULT=USD
INVOICE_DUE_DAYS=14

# --- PDF ---
PDF_TIMEOUT_MS=20000
PDF_MAX_BYTES=5242880
# Set in the Docker image to /usr/bin/chromium. For running the worker outside Docker, point
# this at a locally installed Chrome/Chromium binary.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# --- Queues ---
QUEUE_PDF_CONCURRENCY=2
QUEUE_EMAIL_CONCURRENCY=5
QUEUE_JOB_ATTEMPTS=3
QUEUE_BACKOFF_DELAY_MS=3000
QUEUE_STUCK_SWEEP_INTERVAL_MS=60000
QUEUE_STUCK_TIMEOUT_MS=120000
EMAIL_RATE_LIMIT_MAX=50
EMAIL_RATE_LIMIT_DURATION_MS=60000

# --- HTTP ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
# Tighter limit for POST /auth/register and /auth/login specifically.
AUTH_RATE_LIMIT_MAX=10
SHUTDOWN_TIMEOUT_MS=15000
